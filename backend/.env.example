# =============================================================================
# PRAVAH — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored.
# =============================================================================

# --- ENVIRONMENT ---
ENV=development
DEBUG=True

# --- DATABASE ---
# PostgreSQL connection string (must support pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/pravah_db

# --- SECURITY & AUTH ---
SECRET_KEY=your-super-secret-jwt-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- AI & LLM INTEGRATIONS ---
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AQ.Ab8RN6IhIXbShviIBAUJ0uI5Zf7UjwUIFs4AQoPBE-RoTB4uRQ
AI_MODEL_TEXT=gemini-3.5-flash
AI_MODEL_VISION=gpt-4o
MAX_TOKENS=2000

# --- EXTERNAL SERVICES ---
DIGILOCKER_CLIENT_ID=your_client_id
DIGILOCKER_CLIENT_SECRET=your_client_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
